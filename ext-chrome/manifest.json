{
  "manifest_version": 3,
  "name": "Musik Tools",
  "version": "0.1.0",
  "description": "Tempo, transpose dan minus one untuk audio/video di tab aktif.",
  "key": "",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Musik Tools",
    "default_popup": "popup.html"
  },
  "permissions": ["activeTab", "scripting"],
  "web_accessible_resources": [
    {
      "resources": ["worklet.js", "rubberband.wasm"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "128": "icon-128.png"
  }
}
