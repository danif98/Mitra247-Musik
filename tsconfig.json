{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node", "vite/client", "chrome"],
    "paths": {
      "@personal": ["./app-pwa/src/personal/index.ts"],
      "@changelog?raw": ["./CHANGELOG.md"]
    }
  },
  "include": [
    "core",
    "ui",
    "app-pwa",
    "ext-chrome",
    "scripts",
    "e2e",
    "*.ts",
    "ui/**/*.svelte",
    "app-pwa/**/*.svelte"
  ],
  "exclude": ["node_modules", "dist", "out", "server", ".scratch"]
}
