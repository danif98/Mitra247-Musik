{
  "name": "musik",
  "version": "0.6.2",
  "private": true,
  "description": "Musik Tools: personal music practice player (speed, transpose, minus one, YouTube to MP3).",
  "license": "GPL-3.0-only",
  "author": "DF",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "core",
    "ui",
    "app-pwa",
    "app-android",
    "ext-chrome",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev -w app-pwa",
    "build": "node scripts/build.mjs",
    "build:ext": "node ext-chrome/build.mjs",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json && tsc -p server/tsconfig.json --noEmit && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:e2e": "node e2e/run.mjs && node e2e/app.mjs && node e2e/practice.mjs && node e2e/minusone.mjs && node e2e/search.mjs && node e2e/ytsearch.mjs && node e2e/lazyqueue.mjs && node e2e/about.mjs && node e2e/playscreen.mjs && node e2e/volume.mjs && node e2e/export.mjs && node e2e/key.mjs && node e2e/queuefit.mjs && node e2e/account.mjs && node e2e/auth-server.mjs",
    "test:e2e:play": "node scripts/build-play.mjs && node e2e/play.mjs && node scripts/check-play-clean.mjs",
    "check:pure-js": "node scripts/check-pure-js.mjs",
    "deploy:prepare": "node scripts/deploy-prepare.mjs",
    "vendor:zip": "node scripts/vendor-zip.mjs",
    "smoke:server": "node scripts/smoke-server.mjs",
    "android:apk": "node scripts/android.mjs",
    "android:personal:apk": "node scripts/android.mjs",
    "android:sync": "node scripts/android.mjs sync",
    "android:play:aab": "node scripts/android.mjs play",
    "android:play:apk": "node scripts/android.mjs play-apk",
    "android:play:sync": "node scripts/android.mjs play-sync",
    "build:play": "node scripts/build-play.mjs",
    "play:listing": "node scripts/play-listing.mjs",
    "check:play-clean": "node scripts/check-play-clean.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/chrome": "^0.3.7",
    "@types/node": "^22.0.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-svelte": "^3.0.0",
    "globals": "^16.0.0",
    "playwright-core": "^1.65.1",
    "prettier": "^3.8.0",
    "prettier-plugin-svelte": "^3.4.0",
    "svelte-check": "^4.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.50.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
