{
  "name": "musik",
  "version": "0.1.0",
  "private": true,
  "description": "Musik Tools: personal music practice player (speed, transpose, minus one, YouTube to MP3).",
  "license": "GPL-3.0-only",
  "author": "DF",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "core",
    "ui",
    "app-pwa",
    "ext-chrome",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev -w app-pwa",
    "build": "node scripts/build.mjs",
    "build:ext": "node ext-chrome/build.mjs",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json && tsc -p server/tsconfig.json --noEmit && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:e2e": "node e2e/run.mjs && node e2e/app.mjs && node e2e/practice.mjs && node e2e/minusone.mjs",
    "check:pure-js": "node scripts/check-pure-js.mjs",
    "deploy:prepare": "node scripts/deploy-prepare.mjs",
    "vendor:zip": "node scripts/vendor-zip.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/chrome": "^0.3.7",
    "@types/node": "^22.0.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-svelte": "^3.0.0",
    "globals": "^16.0.0",
    "playwright-core": "^1.65.1",
    "prettier": "^3.8.0",
    "prettier-plugin-svelte": "^3.4.0",
    "svelte-check": "^4.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.50.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
