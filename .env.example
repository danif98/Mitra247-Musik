# Copy to .env (project root for local runs; ~/musik-deploy/.env on the server, chmod 600), or set these
# in cPanel > Setup Node.js App > Environment variables (recommended; they win over .env).
# Never commit real values.
# Generate a token: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Set by Passenger on cPanel; only needed for local runs.
PORT=3000

# Required. >= 32 characters (use 32 random bytes as hex). Without it only GET /api/health works.
MUSIK_TOKEN=

# Absolute paths on the server, e.g. /home/<user>/ytvenv/bin/yt-dlp and /home/<user>/bin/ffmpeg
YTDLP_PATH=
FFMPEG_PATH=

# Where jobs/ and cache/ live (finished MP3s are deleted after RETENTION_MINUTES). Default: ./data
DATA_DIR=

# Comma separated origins allowed by CORS: the PWA origin (scheme + host, no path) and the
# extension origin chrome-extension://<id> if you use it. Empty = browsers cannot call the API.
ALLOWED_ORIGINS=

# yt-dlp JavaScript runtime (see docs/DEPLOY.md), e.g. node:/home/<user>/nodevenv/<app>/<ver>/bin/node
YTDLP_JS_RUNTIME=

# Optional: when YouTube blocks the server IP ("Sign in to confirm you're not a bot"), see docs/DEPLOY.md 3.2
# YTDLP_PROXY=socks5h://user:password@host:1080
# YTDLP_COOKIES_FILE=/home/<user>/musik-secrets/cookies.txt

# Optional tuning (defaults shown)
# MAX_ACTIVE=1            concurrent conversions, 1-2
# MAX_QUEUE=3             jobs allowed to wait
# MAX_DURATION_SEC=1200   longer videos are refused
# RETENTION_MINUTES=60    MP3 files are removed this long after they finish
# JOB_TIMEOUT_SEC=300     a conversion running longer is killed
# TRUST_PROXY=true        client IP = last X-Forwarded-For entry (set false when not behind a proxy)
